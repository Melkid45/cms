# Vercel project root: admin. Set these in Vercel Environment Variables.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
CMS_ADMIN_EMAIL=owner@example.com
CMS_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
CMS_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional email delivery. Without SMTP messages are still saved in Inbox.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=account@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Website <account@example.com>
