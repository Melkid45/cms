# Vercel project root: admin. Set these in Vercel Environment Variables.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token
CMS_ADMIN_EMAIL=owner@example.com
CMS_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
CMS_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# Optional Telegram bridge: base64 SPKI public key from cms.mjs --init. Never a private key.
CMS_BOT_PUBLIC_KEY=

# Optional email delivery. Without SMTP messages are still saved in Inbox.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=account@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Website <account@example.com>

# Optional paid AI through OpenRouter (off unless CMS_AI=1). Monthly budget in USD.
OPENROUTER_API_KEY=
CMS_AI=0
CMS_AI_MODEL=google/gemini-2.5-flash-lite
CMS_AI_MONTHLY_USD=10


# Optional social publishing (Settings → Social accounts). Without these, posts are
# prepared in the admin and published by hand. See BUILDER.md → Social posts.
SOCIAL_META_APP_ID=
SOCIAL_META_APP_SECRET=
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=

# Custom domains (Settings → Domain). Without VERCEL_TOKEN + VERCEL_PROJECT_ID the "local"
# provider is used: DNS is only compared, nothing is added to Vercel. See BUILDER.md → Custom domains.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Expected DNS values shown to clients when Vercel's API is not used (defaults: 76.76.21.21 / cname.vercel-dns.com).
HOSTING_A_RECORD=
HOSTING_CNAME_TARGET=
# Nameservers shown in test mode (comma list; default ns1.vercel-dns.com,ns2.vercel-dns.com). With VERCEL_TOKEN they come from Vercel.
HOSTING_NAMESERVERS=
# Extra admin host names (comma list) if the CMS admin gets its own domain; never treated as client domains.
CMS_HOSTS=
